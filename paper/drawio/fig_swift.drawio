<mxfile host="app.diagrams.net"><diagram name="fig_swift" id="fig_swift"><mxGraphModel dx="1070" dy="595" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1070" pageHeight="595" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="fig_swift-1" value="&lt;b&gt;SWIFT controller&lt;/b&gt;: hardware loop over chunks c = 0 … ⌈D/32⌉ − 1&lt;br&gt;each chunk: address cycle (SRAM read) → data cycle (compute + write back)&lt;br&gt;from PCPI bridge: op, rs1, rs2, DST_ADDR, WEIGHT, K, HVSIZE, GEN_SEEDL/SEEDP/STEP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1010" height="68" as="geometry"/></mxCell><mxCell id="fig_swift-2" value="&lt;b&gt;Bit SPM B&lt;/b&gt;&lt;br&gt;512 × 32 b, port b" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="170" height="65" as="geometry"/></mxCell><mxCell id="fig_swift-3" value="&lt;b&gt;Bit SPM A&lt;/b&gt;&lt;br&gt;512 × 32 b, port a" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="40" y="215" width="170" height="65" as="geometry"/></mxCell><mxCell id="fig_swift-4" value="&lt;b&gt;Signed weighted MAC&lt;/b&gt; × 32&lt;br&gt;b = L ⊕ P (encode) or hv (update)&lt;br&gt;X ← sat&lt;sub&gt;W&lt;/sub&gt;(X + (b ? −w : +w))" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="290" height="105" as="geometry"/></mxCell><mxCell id="fig_swift-5" value="&lt;b&gt;Dot search&lt;/b&gt;&lt;br&gt;s&lt;sub&gt;k&lt;/sub&gt; = Σ (y ? −h&lt;sub&gt;k&lt;/sub&gt; : +h&lt;sub&gt;k&lt;/sub&gt;), 2W bits&lt;br&gt;argmax&lt;sub&gt;k&lt;/sub&gt; s&lt;sub&gt;k&lt;/sub&gt; → class index → rd" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="290" height="95" as="geometry"/></mxCell><mxCell id="fig_swift-6" value="&lt;b&gt;Sign&lt;/b&gt; × 32:  y = MSB(X), 0 → +1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="370" width="290" height="60" as="geometry"/></mxCell><mxCell id="fig_swift-7" value="&lt;b&gt;L2 normalize&lt;/b&gt; (serial)&lt;br&gt;Σ h² one lane/cycle → isqrt&lt;br&gt;one shared restoring divider&lt;br&gt;h ← h / ‖h‖ in Q1.(W−1)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="330" y="455" width="290" height="110" as="geometry"/></mxCell><mxCell id="fig_swift-8" value="&lt;b&gt;Wide SPM&lt;/b&gt;&lt;br&gt;1024 × 512 b&lt;br&gt;16 × 4 KB macros&lt;br&gt;X and K prototypes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1"><mxGeometry x="720" y="230" width="170" height="130" as="geometry"/></mxCell><mxCell id="fig_swift-9" value="&lt;b&gt;Lane formats (W = 16)&lt;/b&gt;&lt;br&gt;X, h: W-bit signed, saturating&lt;br&gt;weight w: 8-bit signed&lt;br&gt;dot sum: 2W = 32 bits&lt;br&gt;Σh²: 2W+16 = 48 b; norm: W+8 = 24 b&lt;br&gt;normalized h: Q1.(W−1)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.0;fontSize=13;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=4;dashed=1;" vertex="1" parent="1"><mxGeometry x="720" y="405" width="320" height="150" as="geometry"/></mxCell><mxCell id="fig_swift-10" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;endSize=6;startSize=6;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="152" as="sourcePoint"/><mxPoint x="330" y="152" as="targetPoint"/></mxGeometry></mxCell><mxCell id="fig_swift-11" value="P" style="text;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="40" height="20" as="geometry"/></mxCell><mxCell id="fig_swift-12" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;endSize=6;startSize=6;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="235" as="sourcePoint"/><mxPoint x="330" y="200" as="targetPoint"/><Array as="points"><mxPoint x="270" y="235"/><mxPoint x="270" y="200"/></Array></mxGeometry></mxCell><mxCell id="fig_swift-13" value="L / hv" style="text;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="276" y="180" width="52" height="18" as="geometry"/></mxCell><mxCell id="fig_swift-14" value="" style="edgeStyle=none;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;endSize=6;startSize=6;endArrow=block;endFill=1;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="210" y="270" as="sourcePoint"/><mxP